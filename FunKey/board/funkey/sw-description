software =
{
	version = "3.1.3";

	hardware-compatibility = [ "#RE:^Rev\.[D-F]$" ];

	images: (
	{
        filename = "rootfs.ext2.gz";
        device = "/dev/mmcblk0p2";
		type = "raw";
		installed-directly = true;
		compressed = "zlib";
	}
	);
	scripts: (
	{
		filename = "update_partition";
		type = "shellscript";
	}
	);
}
