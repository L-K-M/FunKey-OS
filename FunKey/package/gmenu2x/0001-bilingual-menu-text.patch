 /// -------------- FUNCTIONS IMPLEMENTATION --------------
+
+/* This helper, and every gloss handed to it, is one of three copies. The FunKey
+ * menu exists three times over -- src/funkeymenu.cpp in gmenu2x (the launcher
+ * menu), funkey/fk_menu.c in picoarch (the in-game menu), and
+ * Source/Menu/MenuMode.cpp in RetroFE (the library menu) -- in three trees
+ * patched independently, so nothing here is shared at build time and only
+ * matching edits keep them in step. Change a gloss in one and the console shows
+ * different Chinese depending on which menu was opened. 3.1.2 shipped precisely
+ * that, having translated the gmenu2x copy alone, which is the one a default
+ * install never draws. */
+/* One TTF_Font is one face and SDL_ttf does not fall back between them, so a
+ * line that mixes scripts cannot come out of a single render call: OpenSans has
+ * no Chinese, and Droid Sans Fallback has no bold Latin. Render each half with
+ * the font that has it and lay the two side by side.
+ *
+ * The halves also need different calls. TTF_RenderText_* reads its argument as
+ * Latin-1, which is right for the English and would make mojibake of UTF-8
+ * Chinese, so the Chinese goes through TTF_RenderUTF8_* instead.
+ *
+ * cjk may be NULL -- for a proper noun, or for a string carrying no useful
+ * gloss -- and a missing font is not fatal: either way the English is returned
+ * on its own, which is what an image whose fonts-droid predates this change
+ * will do. The caller frees the result exactly as it freed the old one. */
+static SDL_Surface *render_bilingual(TTF_Font *latin_font, TTF_Font *cjk_font,
+		const char *latin, const char *cjk, SDL_Color color)
+{
+	SDL_Surface *latin_surface = TTF_RenderText_Blended(latin_font, latin, color);
+	if(!latin_surface || !cjk || !cjk_font){
+		return latin_surface;
+	}
+
+	SDL_Surface *cjk_surface = TTF_RenderUTF8_Blended(cjk_font, cjk, color);
+	if(!cjk_surface){
+		MENU_ERROR_PRINTF("ERROR in render_bilingual: could not render %s, %s\n", cjk, TTF_GetError());
+		return latin_surface;
+	}
+
+	/* Sat on a shared baseline, not centred against each other: the two fonts
+	 * are different sizes, and centring leaves the Chinese visibly riding above
+	 * the Latin it is annotating. */
+	int gap = TTF_FontHeight(latin_font)/3;
+	int latin_y = 0;
+	int cjk_y = TTF_FontAscent(latin_font) - TTF_FontAscent(cjk_font);
+	if(cjk_y < 0){
+		latin_y = -cjk_y;
+		cjk_y = 0;
+	}
+	int w = latin_surface->w + gap + cjk_surface->w;
+	int h = (latin_y + latin_surface->h > cjk_y + cjk_surface->h)?
+			latin_y + latin_surface->h : cjk_y + cjk_surface->h;
+	SDL_Surface *line = SDL_CreateRGBSurface(SDL_SWSURFACE, w, h, 32,
+			latin_surface->format->Rmask, latin_surface->format->Gmask,
+			latin_surface->format->Bmask, latin_surface->format->Amask);
+	if(!line){
+		MENU_ERROR_PRINTF("ERROR in render_bilingual: %s\n", SDL_GetError());
+		SDL_FreeSurface(cjk_surface);
+		return latin_surface;
+	}
+	SDL_FillRect(line, NULL, SDL_MapRGBA(line->format, 0, 0, 0, 0));
+
+	/* Copied rather than blended. Blending a surface that carries per-pixel
+	 * alpha onto a fully transparent one leaves the destination transparent,
+	 * and the glyphs never appear. */
+	SDL_SetAlpha(latin_surface, 0, SDL_ALPHA_OPAQUE);
+	SDL_SetAlpha(cjk_surface, 0, SDL_ALPHA_OPAQUE);
+
+	SDL_Rect pos;
+	pos.x = 0;
+	pos.y = latin_y;
+	SDL_BlitSurface(latin_surface, NULL, line, &pos);
+	pos.x = latin_surface->w + gap;
+	pos.y = cjk_y;
+	SDL_BlitSurface(cjk_surface, NULL, line, &pos);
+
+	SDL_FreeSurface(latin_surface);
+	SDL_FreeSurface(cjk_surface);
+	return line;
+}
+
+/* Keyed on the English rather than on the enum, so that reordering or
+ * respelling the ASPECT_RATIOS list cannot silently pair a ratio with the wrong
+ * gloss. An unrecognised name is not an error -- it just renders untranslated. */
+static const char *aspect_ratio_cjk(const char *name)
+{
+	if(!strcmp(name, "NATIVE"))      return "原始";
+	if(!strcmp(name, "SCALED"))      return "等比";
+	if(!strcmp(name, "STRETCHED"))   return "拉伸";
+	if(!strcmp(name, "STRECHED"))    return "拉伸";
+	if(!strcmp(name, "CROPPED"))     return "裁剪";
+	if(!strcmp(name, "MANUAL"))      return "手动";
+	if(!strcmp(name, "MANUAL ZOOM")) return "手动缩放";
+	return NULL;
+}
