+#define MENU_FONT_NAME_CJK          "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf"
+
+/* A line has to fit the white zone background, not the screen. The background
+ * PNG is MENU_BG_SQURE_WIDTH across while the text is centred over the full
+ * MENU_ZONE_WIDTH, so anything wider than the box spills past both of its
+ * edges with nothing behind it. The English was already sized to fill that
+ * box -- POWERDOWN alone very nearly does -- so appending a gloss at the same
+ * size overflows by design, not by accident. */
+#define MENU_TEXT_MAX_WIDTH         (MENU_BG_SQURE_WIDTH - 8)
+
+/* Latin and CJK point sizes, largest first. A bilingual line is rendered at the
+ * largest rung that fits MENU_TEXT_MAX_WIDTH, so a short title keeps the size
+ * the menu has always used and only the long ones step down. Rung 0 and rung 2
+ * carry MENU_FONT_SIZE_TITLE and MENU_FONT_SIZE_INFO, which is why titles start
+ * at the first and the smaller lines beneath them at the third. */
+static const int menu_font_tiers[][2] = {
