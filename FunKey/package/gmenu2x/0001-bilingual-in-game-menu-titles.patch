 TTF_Font *FunkeyMenu::menu_title_font = NULL;
 TTF_Font *FunkeyMenu::menu_info_font = NULL;
 TTF_Font *FunkeyMenu::menu_small_info_font = NULL;
+
+/* Not a member: nothing outside this file draws a menu title. */
+static TTF_Font *menu_cjk_font = NULL;
+
+/* One TTF_Font is one face and SDL_ttf does not fall back between them, so a
+ * title that mixes scripts cannot come out of a single render call -- OpenSans
+ * has no Chinese, and Droid Sans Fallback has no bold Latin. Render each half
+ * with the font that has it and lay the two side by side.
+ *
+ * The halves also need different calls. TTF_RenderText_* reads its argument as
+ * Latin-1, which is right for the English and would make mojibake of UTF-8
+ * Chinese, so the Chinese goes through TTF_RenderUTF8_* instead.
+ *
+ * cjk may be NULL for a title that is a proper noun and is not translated, and
+ * a missing font is not fatal: either way the English is returned on its own,
+ * which is what an image whose fonts-droid predates the move to the path
+ * gmenu2x looks in will do. */
+static SDL_Surface *render_menu_title(TTF_Font *latin_font, const char *latin,
+		const char *cjk, SDL_Color color)
+{
+	SDL_Surface *latin_surface = TTF_RenderText_Blended(latin_font, latin, color);
+	if(!latin_surface || !cjk || !menu_cjk_font){
+		return latin_surface;
+	}
+
+	SDL_Surface *cjk_surface = TTF_RenderUTF8_Blended(menu_cjk_font, cjk, color);
+	if(!cjk_surface){
+		MENU_ERROR_PRINTF("ERROR in render_menu_title: could not render %s, %s\n", cjk, TTF_GetError());
+		return latin_surface;
+	}
+
+	/* Sat on a shared baseline, not centred against each other: the two fonts
+	 * are different sizes, and centring leaves the Chinese visibly riding
+	 * above the Latin it is annotating. */
+	int gap = TTF_FontHeight(latin_font)/3;
+	int latin_y = 0;
+	int cjk_y = TTF_FontAscent(latin_font) - TTF_FontAscent(menu_cjk_font);
+	if(cjk_y < 0){
+		latin_y = -cjk_y;
+		cjk_y = 0;
+	}
+	int w = latin_surface->w + gap + cjk_surface->w;
+	int h = (latin_y + latin_surface->h > cjk_y + cjk_surface->h)?
+			latin_y + latin_surface->h : cjk_y + cjk_surface->h;
+	SDL_Surface *title = SDL_CreateRGBSurface(SDL_SWSURFACE, w, h, 32,
+			latin_surface->format->Rmask, latin_surface->format->Gmask,
+			latin_surface->format->Bmask, latin_surface->format->Amask);
+	if(!title){
+		MENU_ERROR_PRINTF("ERROR in render_menu_title: %s\n", SDL_GetError());
+		SDL_FreeSurface(cjk_surface);
+		return latin_surface;
+	}
+	SDL_FillRect(title, NULL, SDL_MapRGBA(title->format, 0, 0, 0, 0));
+
+	/* Copied rather than blended. Blending a surface that carries per-pixel
+	 * alpha onto a fully transparent one leaves the destination transparent,
+	 * and the glyphs never appear. */
+	SDL_SetAlpha(latin_surface, 0, SDL_ALPHA_OPAQUE);
+	SDL_SetAlpha(cjk_surface, 0, SDL_ALPHA_OPAQUE);
+
+	SDL_Rect pos;
+	pos.x = 0;
+	pos.y = latin_y;
+	SDL_BlitSurface(latin_surface, NULL, title, &pos);
+	pos.x = latin_surface->w + gap;
+	pos.y = cjk_y;
+	SDL_BlitSurface(cjk_surface, NULL, title, &pos);
+
+	SDL_FreeSurface(latin_surface);
+	SDL_FreeSurface(cjk_surface);
+	return title;
+}
 SDL_Surface *img_arrow_top = NULL;
