+static const char *FALLBACK_FONT_PATH =
+        "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf";
+
 Font::Font(std::string fontPath, int fontSize, SDL_Color color)
     : texture(NULL)
+    , primaryFont_(NULL)
+    , fallbackFont_(NULL)
     , fontPath_(fontPath)
     , fontSize_(fontSize)
     , color_(color)
@@ -48,10 +56,104 @@ int Font::getAscent()
 {
     return ascent;
 }
+unsigned int Font::nextCodepoint(const std::string &text, size_t &index)
+{
+    unsigned char lead = static_cast<unsigned char>(text[index]);
+    size_t length;
+    unsigned int codepoint;
+
+    if(lead < 0x80)      { ++index; return lead; }
+    else if((lead & 0xE0) == 0xC0) { length = 2; codepoint = lead & 0x1F; }
+    else if((lead & 0xF0) == 0xE0) { length = 3; codepoint = lead & 0x0F; }
+    else if((lead & 0xF8) == 0xF0) { length = 4; codepoint = lead & 0x07; }
+    else                 { ++index; return lead; }
+
+    if(index + length > text.size())
+    {
+        ++index;
+        return lead;
+    }
+
+    for(size_t i = 1; i < length; ++i)
+    {
+        unsigned char cont = static_cast<unsigned char>(text[index + i]);
+        if((cont & 0xC0) != 0x80)
+        {
+            ++index;
+            return lead;
+        }
+        codepoint = (codepoint << 6) | (cont & 0x3F);
+    }
+
+    index += length;
+    return codepoint;
+}
+
+bool Font::addGlyph(unsigned int charCode)
+{
+    /* TTF_RenderGlyph_Blended and TTF_GlyphIsProvided are UCS-2, so this
+     * reaches the Basic Multilingual Plane and no further. That covers
+     * Chinese, Japanese, Korean, Cyrillic and Greek; it leaves out emoji and
+     * the rarer CJK extensions, which no layout here asks for. */
+    if(charCode > 0xFFFF)
+    {
+        return false;
+    }
+
+    TTF_Font *face = NULL;
+    if(primaryFont_ && TTF_GlyphIsProvided(primaryFont_, (Uint16)charCode))
+    {
+        face = primaryFont_;
+    }
+    else if(fallbackFont_ && TTF_GlyphIsProvided(fallbackFont_, (Uint16)charCode))
+    {
+        face = fallbackFont_;
+    }
+
+    if(!face)
+    {
+        return false;
+    }
+
+    GlyphInfoBuild *info = new GlyphInfoBuild;
+    memset(info, 0, sizeof(GlyphInfoBuild));
+
+    info->surface = TTF_RenderGlyph_Blended(face, (Uint16)charCode, color_);
+    if(!info->surface)
+    {
+        delete info;
+        return false;
+    }
+
+    TTF_GlyphMetrics(face, (Uint16)charCode,
+            &info->glyph.minX, &info->glyph.maxX,
+            &info->glyph.minY, &info->glyph.maxY,
+            &info->glyph.advance);
+
+    /* Its own surface rather than a slot in the atlas: the atlas is packed and
+     * blitted once at initialize(), and growing it later would move every
+     * glyph already in it. */
+    info->glyph.rect.x = 0;
+    info->glyph.rect.y = 0;
+    info->glyph.rect.w = info->surface->w;
+    info->glyph.rect.h = info->surface->h;
+    info->glyph.surface = info->surface;
+    SDL_SetAlpha(info->surface, 0, SDL_ALPHA_OPAQUE);
+
+    atlas[charCode] = info;
+
+    return true;
+}
+
