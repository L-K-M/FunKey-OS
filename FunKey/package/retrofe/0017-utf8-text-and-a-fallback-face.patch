     std::map<unsigned int, GlyphInfoBuild *>::iterator atlasIt = atlas.begin();
     while(atlasIt != atlas.end())
     {
+        /* Glyphs added after initialize() own their surface; the ones packed
+         * into the atlas had theirs freed when it was built. */
+        if(atlasIt->second->surface)
+        {
+            SDL_FreeSurface(atlasIt->second->surface);
+            atlasIt->second->surface = NULL;
+        }
