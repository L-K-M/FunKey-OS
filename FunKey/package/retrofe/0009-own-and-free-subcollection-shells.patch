@@ -52,6 +52,21 @@ CollectionInfo::CollectionInfo(std::string name,
 
 CollectionInfo::~CollectionInfo()
 {
+    // Free the subcollection shells merged in through .sub files. Their
+    // items are the very same Item objects as this collection's -- owned
+    // here -- so empty each shell's list first: its destructor would
+    // otherwise delete every shared Item a second time. The back-pointers
+    // (Item::collectionInfo) must stay valid until this collection is
+    // torn down, which is why the shells are owned rather than deleted at
+    // merge time: launching and favorite toggling both resolve the owning
+    // system through that pointer.
+    for(std::vector<CollectionInfo *>::iterator it = ownedSubcollections_.begin(); it != ownedSubcollections_.end(); ++it)
+    {
+        (*it)->items.clear();
+        delete *it;
+    }
+    ownedSubcollections_.clear();
+
     Playlists_T::iterator pit = playlists.begin();
 
     while(pit != playlists.end())
@@ -222,6 +237,17 @@ void CollectionInfo::addSubcollection(CollectionInfo *newinfo)
 }
 
 
+// Take ownership of a subcollection whose items were merged into this one.
+// The shell has to live exactly as long as this collection: merged items
+// point back at it through Item::collectionInfo.
+void CollectionInfo::addOwnedSubcollection(CollectionInfo *info)
+{
+    if(info)
+    {
+        ownedSubcollections_.push_back(info);
+    }
+}
+
 // Merge a subcollection's playlist into this collection's playlist of the same
 // name. addSubcollection() has already merged the items themselves and they are
 // the very same Item objects, so only playlist membership needs copying.
