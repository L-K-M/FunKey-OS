-// A line of text shown for a moment and then cleared, by whichever component
-// the theme declares as its statusText. Used to acknowledge an action that
-// otherwise leaves the screen looking exactly as it did before.
+namespace
+{
+    // The kernel notification overlay every other OS notice on the device
+    // uses -- volume, brightness, screenshot, low battery, shutdown. The
+    // fbtft display driver composites it over whatever is on the
+    // framebuffer: above any theme, and above RetroFE itself, which is how
+    // the volume OSD already appears while browsing. No layout support
+    // needed, and no per-theme placement to get wrong.
+    const char *NOTIFICATION_NODE = "/sys/class/graphics/fb0/notification";
+
+    // Probed once: the node either exists for the whole run or never does
+    // (desktop builds, where the fallback below is wanted).
+    bool notificationAvailable()
+    {
+        static int available = -1;
+        if(available < 0)
+        {
+            // Probe everything the display path depends on: the node, and
+            // the helper being resolvable on PATH -- one shot, cached.
+            struct stat info;
+            available = (stat(NOTIFICATION_NODE, &info) == 0 &&
+                         system("command -v notif >/dev/null 2>&1") == 0) ? 1 : 0;
+        }
+        return available == 1;
+    }
+}
+
+
+// A line of text shown for a moment and then cleared, used to acknowledge an
+// action that otherwise leaves the screen looking exactly as it did before.
+//
+// On device this goes through the "notif" shell helper rather than a direct
+// sysfs write: "notif set" backgrounds a process that retracts the message
+// when the time is up, and RetroFE may be busy launching a game -- or gone
+// entirely -- when that moment comes. It also replaces rather than stacks
+// with any other notice in flight, and later notices replace it.
+//
+// Everywhere else the theme's statusText component shows it. That is only a
+// fallback: the shipped themes draw their statusText where the game title
+// already sits, and Text components overdraw rather than replace, so on
+// device both strings would be on top of each other.
 void Page::setStatusMessage(const std::string &message, float seconds)
 {
+    // seconds <= 0 keeps its old meaning -- show with no timer -- so only
+    // positive durations go to the self-clearing overlay.
+    if(notificationAvailable() && seconds > 0.0f)
+    {
+        // The overlay draws 8x8 text, 30 columns to the 240px screen, and
+        // breaks lines on '\n' (its shell users write '^'). Wrap at word
+        // boundaries and pad each line to centre it, matching the volume
+        // OSD.
+        std::string upper = message;
+        for(std::string::iterator it = upper.begin(); it != upper.end(); ++it)
+        {
+            // The overlay treats '^' as a line break, so it cannot appear
+            // in a message. Apostrophes are escaped when the command is
+            // built below -- after the wrap, so the escape bytes cannot
+            // distort the 30-column arithmetic. The cast keeps toupper
+            // defined for bytes >= 0x80 on signed-char platforms.
+            *it = (*it == '^') ? ' ' : std::toupper(static_cast<unsigned char>(*it));
+        }
+
+        std::string osd;
+        std::string line;
+        std::string word;
+        std::stringstream words(upper);
+        while(words >> word)
+        {
+            // A word longer than a whole line would be clipped by the
+            // 30-column overlay: split it across lines first, full width.
+            while(word.length() > 30)
+            {
+                if(!line.empty())
+                {
+                    osd += std::string(line.length() < 30 ? (30 - line.length()) / 2 : 0, ' ') + line + "\n";
+                    line.clear();
+                }
+                osd += word.substr(0, 30) + "\n";
+                word.erase(0, 30);
+            }
+            if(!line.empty() && line.length() + 1 + word.length() > 30)
+            {
+                osd += std::string(line.length() < 30 ? (30 - line.length()) / 2 : 0, ' ') + line + "\n";
+                line.clear();
+            }
+            if(!line.empty()) line += ' ';
+            line += word;
+        }
+        if(!line.empty())
+        {
+            // Clamped, because (30 - length) would underflow to a huge
+            // count and std::string would throw.
+            osd += std::string(line.length() < 30 ? (30 - line.length()) / 2 : 0, ' ') + line;
+        }
+
+        int secs = static_cast<int>(seconds + 0.5f);
+        if(secs < 1) secs = 1;
+
+        std::stringstream cmd;
+        cmd << "notif set " << secs << " '";
+        // ' is the only byte a single-quoted shell word cannot hold; the
+        // POSIX idiom closes, escapes, and reopens the quote around it.
+        for(std::string::size_type i = 0; i < osd.size(); ++i)
+        {
+            if(osd[i] == '\'') cmd << "'\\''";
+            else               cmd << osd[i];
+        }
+        cmd << "'";
+        if(system(cmd.str().c_str()) == 0)
+        {
+            statusMessage_.clear();
+            statusMessageTime_ = 0.0f;
+            return;
+        }
+
+        // The helper failed even though the node exists (PATH, perms):
+        // fall through to the theme's statusText rather than leave the
+        // keypress unanswered.
+        Logger::write(Logger::ZONE_WARNING, "Page", "Could not show notification: " + message);
+    }
+
     statusMessage_     = message;
     statusMessageTime_ = seconds;
 }
