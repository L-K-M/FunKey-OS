+// Pressing Y had no visible effect: the game stays where it is, and nothing on
+// screen said anything happened. ScrollingList draws Item::title directly, so
+// marking that is what makes the state visible -- in the menu you are actually
+// looking at, in every theme, without any theme needing a component it does not
+// already have.
+//
+// title and not fullTitle: sortPlaylists orders on lowercaseFullTitle, so a
+// marker there would make a game jump position the moment you toggled it.
+// Save() writes Item::name, so the marker cannot reach favorites.txt either.
+//
+// ASCII and not a star glyph: this has to render in whatever font a theme
+// ships, and a missing glyph would look exactly like the bug being fixed.
+const std::string CollectionInfo::favoriteMarker = "* ";
+
+void CollectionInfo::markFavorite(Item *item, bool favorite)
+{
+    if(!item) return;
+
+    bool marked = item->title.compare(0, favoriteMarker.size(), favoriteMarker) == 0;
+
+    if(favorite && !marked)
+    {
+        item->title = favoriteMarker + item->title;
+    }
+    else if(!favorite && marked)
+    {
+        item->title.erase(0, favoriteMarker.size());
+    }
+}
