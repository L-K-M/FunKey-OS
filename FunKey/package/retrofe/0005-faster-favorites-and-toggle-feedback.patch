 // Load a collection
+// Whether a collection's favorites playlist exists and names at least one game.
+// Read from userPath: playlists live on the writable partition, and the copy
+// under absolutePath is the read-only one shipped in the image.
+//
+// Blank lines are not favorites. A file left behind with nothing in it -- which
+// is what unfavoriting the last game produces -- would otherwise still cost a
+// full scan of that system every time Favorites is opened.
+bool RetroFE::collectionHasFavorites(std::string collectionName)
+{
+    if ( Configuration::userPath.empty( ) ) return false;
+
+    std::string file = Utils::combinePath( Configuration::userPath, "collections", collectionName, "playlists", "favorites.txt" );
+
+    std::ifstream stream( file.c_str( ) );
+    if ( !stream.good( ) ) return false;
+
+    std::string line;
+    while ( std::getline( stream, line ) )
+    {
+        if ( line.find_first_not_of( " \t\r\n" ) != std::string::npos ) return true;
+    }
+
+    return false;
+}
