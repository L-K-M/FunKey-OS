+// Look up the favorites playlist without creating it. Using
+// playlists["favorites"] here would insert a NULL entry for any collection
+// built without playlists, which the callers would then dereference.
+static std::vector<Item *> *favoritesOf(CollectionInfo *collection)
+{
+    CollectionInfo::Playlists_T::iterator it = collection->playlists.find("favorites");
+
+    if(it == collection->playlists.end()) return NULL;
+
+    return it->second;
+}
+
+
+// True when the selected item is currently in the favorites playlist.
+bool Page::isFavorite()
+{
+    if(!selectedItem_ || collections_.size() == 0) return false;
+
+    std::vector<Item *> *items = favoritesOf(collections_.back().collection);
+
+    if(!items) return false;
+
+    return std::find(items->begin(), items->end(), selectedItem_) != items->end();
+}
+
+
+// Add the selected item to the favorites, or remove it if it is already there,
+// so that a single key covers both directions.
+void Page::togglePlaylist()
+{
+    if(!selectedItem_) return;
+
+    if(isFavorite())
+    {
+        removePlaylist();
+    }
+    else
+    {
+        addPlaylist();
+    }
+}
+
