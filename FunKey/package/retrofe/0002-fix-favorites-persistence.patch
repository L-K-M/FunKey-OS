+// Create a single directory. Returns true if it exists as a directory
+// afterwards, whether we created it or somebody else already had.
+static bool makeDirectory(const std::string &dir)
+{
+    struct stat info;
+    if ( stat( dir.c_str(), &info ) == 0 )
+    {
+        return (info.st_mode & S_IFDIR) != 0;
+    }
+
+#if defined(_WIN32) && !defined(__GNUC__)
+    CreateDirectory( dir.c_str(), NULL );
+#elif defined(__MINGW32__)
+    mkdir( dir.c_str() );
+#else
+    mkdir( dir.c_str(), 0755 );
+#endif
+
+    // Re-stat instead of trusting the return code, so that an "already exists"
+    // race with another writer counts as success on every platform.
+    return stat( dir.c_str(), &info ) == 0 && (info.st_mode & S_IFDIR) != 0;
+}
+
+
+// Create every missing component of dir, like "mkdir -p".
+static bool makeDirectoryRecursive(const std::string &dir)
+{
+    // Start at 1 so a leading slash is not mistaken for an empty component.
+    std::string::size_type position = dir.find_first_of("/\\", 1);
+
+    while ( position != std::string::npos )
+    {
+        if ( !makeDirectory( dir.substr( 0, position ) ) )
+        {
+            return false;
+        }
+        position = dir.find_first_of( "/\\", position + 1 );
+    }
+
+    return makeDirectory( dir );
+}
