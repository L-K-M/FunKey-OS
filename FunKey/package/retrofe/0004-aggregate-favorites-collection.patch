+// Merge a subcollection's playlist into this collection's playlist of the same
+// name. addSubcollection() has already merged the items themselves and they are
+// the very same Item objects, so only playlist membership needs copying.
+void CollectionInfo::addSubcollectionPlaylist(CollectionInfo *newinfo, const std::string &playlist)
+{
+    Playlists_T::iterator source = newinfo->playlists.find(playlist);
+    Playlists_T::iterator target = playlists.find(playlist);
+
+    if(source == newinfo->playlists.end() || !source->second) return;
+    if(target == playlists.end() || !target->second) return;
+
+    for(std::vector<Item *>::iterator it = source->second->begin(); it != source->second->end(); it++)
+    {
+        if(std::find(target->second->begin(), target->second->end(), *it) == target->second->end())
+        {
+            target->second->push_back(*it);
+        }
+    }
+}
