+// The collection whose favorites.txt owns the selected game. On a normal system
+// page this is the page's own collection. On a collection aggregated from .sub
+// files -- the Favorites menu entry -- the page shows games belonging to other
+// collections, and their favorites must be written back to the system they came
+// from rather than to the aggregate.
+CollectionInfo *Page::favoritesOwner()
+{
+    CollectionInfo *collection = collections_.back().collection;
+
+    if(selectedItem_ && selectedItem_->collectionInfo)
+    {
+        return selectedItem_->collectionInfo;
+    }
+
+    return collection;
+}
