+// Rebuild only the slot showing the selected item, leaving the other slots'
+// textures alone. allocateSpritePoints() reloads every visible slot -- each
+// one a run of file probes and an image decode off the SD card -- which is a
+// lot of work to answer a change that touched one item (the favorite marker
+// on its title).
+//
+// Slots holding an Image are skipped entirely: the marker lives in
+// Item::title, which only Text components render, so reloading an image would
+// decode the same box art to draw the same picture.
+bool ScrollingList::reloadSelectedItemTexture( )
+{
+    if ( !items_ || items_->size( ) == 0 ) return false;
+    if ( !scrollPoints_ || !tweenPoints_ ) return false;
+    if ( components_.size( ) == 0 ) return false;
+    if ( selectedOffsetIndex_ >= components_.size( ) ) return false;
+    if ( selectedOffsetIndex_ >= scrollPoints_->size( ) ) return false;
+    if ( selectedOffsetIndex_ >= tweenPoints_->size( ) ) return false;
+
+    Item *item = getSelectedItem( );
+    if ( !item ) return false;
+
+    Component *old = components_.at( selectedOffsetIndex_ );
+
+    if ( !dynamic_cast<Text *>( old ) ) return true;
+
+    allocateTexture( selectedOffsetIndex_, item );
+
+    Component *c = components_.at( selectedOffsetIndex_ );
+
+    if ( c && c != old )
+    {
+        ViewInfo *view = scrollPoints_->at( selectedOffsetIndex_ );
+        resetTweens( c, tweenPoints_->at( selectedOffsetIndex_ ), view, view, 0 );
+
+        // Nothing scrolled: keep the new component exactly where the old one
+        // was. components_ is the only owner of these pointers -- allocateTexture
+        // overwrites the slot without freeing what was there -- so deleting it
+        // here is what stops the replacement from leaking, and its destructor
+        // frees the texture.
+        c->baseViewInfo = old->baseViewInfo;
+        delete old;
+    }
+
+    return true;
+}
