diff --git a/RetroFE/Source/Collection/Item.h b/RetroFE/Source/Collection/Item.h
index 64eae9c..3f7c63c 100755
--- a/RetroFE/Source/Collection/Item.h
+++ b/RetroFE/Source/Collection/Item.h
@@ -27,6 +27,10 @@ public:
     std::string filename();
     std::string lowercaseTitle() ;
     std::string lowercaseFullTitle();
+    // The lowercase forms above are cached for the item's life; title is the
+    // one field that can change after load (the favorite marker), and it is
+    // changed through CollectionInfo::markFavorite(), which calls this.
+    void invalidateTitleCache();
     std::string name;
     std::string filepath;
     std::string file;
@@ -52,4 +56,17 @@ public:
     void setInfo( std::string key, std::string value );
     bool getInfo( std::string key, std::string &value );
     void loadInfo( std::string path );
+
+private:
+    // lowercaseTitle()/lowercaseFullTitle() are called from sort comparators,
+    // twice per comparison, and each call used to build a fresh lowercased
+    // string. Sorting a few thousand titles meant tens of thousands of
+    // allocations on a single-core Cortex-A7 while the user waited for a
+    // menu. Both are cached after their first call instead. Titles only
+    // change at load time, and the favorite marker -- the one post-load
+    // change -- goes through markFavorite(), which invalidates the cache.
+    bool lowercaseTitleCached_;
+    bool lowercaseFullTitleCached_;
+    std::string lowercaseTitleCache_;
+    std::string lowercaseFullTitleCache_;
 };
