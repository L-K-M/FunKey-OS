index 0000000..d909f57
--- /dev/null
+++ b/RetroFE/Source/Collection/RecentlyPlayed.cpp
@@ -0,0 +1,262 @@
+/* This file is part of RetroFE.
+ *
+ * RetroFE is free software: you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * RetroFE is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with RetroFE.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "RecentlyPlayed.h"
+#include "CollectionInfo.h"
+#include "Item.h"
+#include "../Database/Configuration.h"
+#include "../Utility/Utils.h"
+#include "../Utility/Log.h"
+#include <fstream>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#if defined(__linux) || defined(__APPLE__)
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstdio>
+#endif
+
+const std::string RecentlyPlayed::collectionName = "Recently Played";
+
+// Twenty is what the carousel can be scrolled through without the list stopping
+// being "recent". The file is rewritten on every launch, so the cost of a
+// larger number is paid on the critical path of starting a game.
+const size_t RecentlyPlayed::maxEntries = 20;
+
+static bool makeDirectory(const std::string &dir)
+{
+#if defined(_WIN32)
+    if(mkdir(dir.c_str()) == 0) return true;
+#else
+    if(mkdir(dir.c_str(), 0755) == 0) return true;
+#endif
+    // Already there is the common case, not a failure.
+    struct stat info;
+    return stat(dir.c_str(), &info) == 0 && (info.st_mode & S_IFDIR);
+}
+
+static bool makeDirectoryRecursive(const std::string &dir)
+{
+    // Start at 1 so a leading slash is not mistaken for an empty component.
+    std::string::size_type position = dir.find_first_of("/\\", 1);
+
+    while(position != std::string::npos)
+    {
+        if(!makeDirectory(dir.substr(0, position)))
+        {
+            return false;
+        }
+        position = dir.find_first_of("/\\", position + 1);
+    }
+
+    return makeDirectory(dir);
+}
+
+std::string RecentlyPlayed::listPath()
+{
+    return Utils::combinePath(Configuration::userPath, "collections", collectionName, "recent.txt");
+}
+
+// Stored as the "_<collection>:<name>" form that favorites.txt already uses for
+// a game belonging to another collection, so both files read the same way and
+// neither needs a format of its own.
+std::vector<RecentlyPlayed::Entry> RecentlyPlayed::load()
+{
+    std::vector<Entry> entries;
+
+    if(Configuration::userPath.empty())
+    {
+        return entries;
+    }
+
+    std::ifstream stream(listPath().c_str());
+    if(!stream.good())
+    {
+        return entries;
+    }
+
+    std::string line;
+    while(std::getline(stream, line) && entries.size() < maxEntries)
+    {
+        // Tolerate the CRLF a card edited on Windows comes back with.
+        while(!line.empty() && (line[line.size() - 1] == '\r' || line[line.size() - 1] == '\n'))
+        {
+            line.erase(line.size() - 1);
+        }
+
+        if(line.empty() || line[0] != '_')
+        {
+            continue;
+        }
+
+        std::string::size_type separator = line.find(":");
+        if(separator == std::string::npos || separator < 2)
+        {
+            continue;
+        }
+
+        std::string collection = line.substr(1, separator - 1);
+        std::string name       = line.substr(separator + 1);
+
+        if(!collection.empty() && !name.empty())
+        {
+            entries.push_back(Entry(collection, name));
+        }
+    }
+
+    return entries;
+}
+
+std::set<std::string> RecentlyPlayed::collections()
+{
+    std::set<std::string> names;
+    std::vector<Entry> entries = load();
+
+    for(std::vector<Entry>::iterator it = entries.begin(); it != entries.end(); it++)
+    {
+        names.insert(it->first);
+    }
+
+    return names;
+}
+
+bool RecentlyPlayed::save(const std::vector<Entry> &entries)
+{
+    std::string dir  = Utils::combinePath(Configuration::userPath, "collections", collectionName);
+    std::string file = listPath();
+
+    if(!makeDirectoryRecursive(dir))
+    {
+        Logger::write(Logger::ZONE_WARNING, "RecentlyPlayed", "Could not create directory " + dir);
+        return false;
+    }
+
+    std::ofstream filestream;
+
+#if !defined(_WIN32)
+    // Written to a sibling and renamed into place, for the same reason
+    // favorites.txt is: a handheld is switched off whenever the user feels like
+    // it, and a write cut in half would leave a truncated list behind. rename()
+    // over an existing target is atomic on the FAT share partition, so the file
+    // is always either the old list or the new one.
+    std::string tmp = file + ".tmp";
+    filestream.open(tmp.c_str());
+#else
+    filestream.open(file.c_str());
+#endif
+
+    if(!filestream.is_open())
+    {
+        Logger::write(Logger::ZONE_WARNING, "RecentlyPlayed", "Could not open " + file + " for writing");
+        return false;
+    }
+
+    for(std::vector<Entry>::const_iterator it = entries.begin(); it != entries.end(); it++)
+    {
+        filestream << "_" << it->first << ":" << it->second << std::endl;
+    }
+
+    filestream.close();
+
+    // ofstream does not throw on write errors, so ask the stream rather than
+    // assume the bytes landed.
+    if(!filestream.good())
+    {
+        Logger::write(Logger::ZONE_WARNING, "RecentlyPlayed", "Failed writing " + file);
+        return false;
+    }
+
+#if !defined(_WIN32)
+    // Flush before the swap, so the rename cannot publish a file whose contents
+    // are still only in the page cache when the power goes.
+    bool flushed = false;
+    int fd = open(tmp.c_str(), O_RDONLY);
+    if(fd >= 0)
+    {
+        flushed = (fsync(fd) == 0);
+        close(fd);
+    }
+
+    if(!flushed || std::rename(tmp.c_str(), file.c_str()) != 0)
+    {
+        Logger::write(Logger::ZONE_WARNING, "RecentlyPlayed", "Could not put " + file + " in place");
+        std::remove(tmp.c_str());
+        return false;
+    }
+#endif
+
+    return true;
+}
+
+void RecentlyPlayed::record(Item *item)
+{
+    if(!item || !item->collectionInfo)
+    {
+        return;
+    }
+
+    // As with favorites, refusing beats writing onto the read-only rootfs at a
+    // path that was meant to be under the user partition.
+    if(Configuration::userPath.empty())
+    {
+        Logger::write(Logger::ZONE_WARNING, "RecentlyPlayed", "Not recording play: user path is not set");
+        return;
+    }
+
+    // The system the game belongs to, never the aggregate menu it was picked
+    // from: an item merged into Favorites or into this list still points at the
+    // collection that built it, which is the one that can launch it again.
+    Entry played(item->collectionInfo->name, item->name);
+
+    if(played.first.empty() || played.second.empty())
+    {
+        return;
+    }
+
+    // A name carrying the separator would be read back as a different game in a
+    // different collection, so it is better not to record it than to record it
+    // wrongly. A ROM filename with a colon cannot exist on the FAT share
+    // partition in the first place.
+    if(played.second.find(":") != std::string::npos || played.first.find(":") != std::string::npos)
+    {
+        Logger::write(Logger::ZONE_INFO, "RecentlyPlayed", "Not recording \"" + played.second + "\": name contains a colon");
+        return;
+    }
+
+    std::vector<Entry> entries = load();
+    std::vector<Entry> updated;
+    updated.push_back(played);
+
+    // Replaying a game moves it to the top rather than appearing twice.
+    for(std::vector<Entry>::iterator it = entries.begin(); it != entries.end(); it++)
+    {
+        if(*it == played)
+        {
+            continue;
+        }
+        if(updated.size() >= maxEntries)
+        {
+            break;
+        }
+        updated.push_back(*it);
+    }
+
+    if(save(updated))
+    {
+        Logger::write(Logger::ZONE_INFO, "RecentlyPlayed", "Recorded " + played.first + " / " + played.second);
+    }
+}
