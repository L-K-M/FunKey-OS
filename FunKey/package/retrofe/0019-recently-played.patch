+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with RetroFE.  If not, see <http://www.gnu.org/licenses/>.
+ */
+#pragma once
+
+#include <string>
+#include <utility>
+#include <set>
+#include <vector>
+
+class Item;
+
+// The games most recently launched, newest first.
+//
+// Favorites are kept per system so that each system's favorites.txt stays the
+// single source of truth for the games inside it. Recency cannot be stored that
+// way: the order is global, and rebuilding one order out of several files would
+// mean writing a timestamp beside every entry and merging them on every menu
+// open. Here one ordered file is both the truth and the order, and the position
+// of a line is the only thing that has to be right.
+//
+// It sits beside the per-system playlist directories rather than inside one,
+// because addPlaylists() loads every .txt it finds in a playlists/ directory
+// into a std::map keyed by name -- which would sort the list alphabetically and
+// so discard the single thing it exists to record.
+class RecentlyPlayed
+{
+public:
+    // <collection name, item name>. The collection is the system the game
+    // belongs to and is launched with, never the aggregate it was picked from.
+    typedef std::pair<std::string, std::string> Entry;
+
+    // Moves item to the front of the list, drops any older entry naming the
+    // same game, truncates to maxEntries and rewrites the file. Every failure
+    // is logged and none is fatal: a console that cannot write its play history
+    // must still launch the game the user asked for.
+    static void record(Item *item);
+
+    // The list, newest first. Empty when there is no file yet, which is the
+    // normal state of a console nobody has played.
+    static std::vector<Entry> load();
+
+    // The systems named in the list. getCollection() uses this to skip building
+    // subcollections that cannot contribute a single game, the way
+    // collectionHasFavorites() does for Favorites -- building one costs a scan
+    // of that system's whole ROM directory.
+    static std::set<std::string> collections();
+
+    static const std::string collectionName;
+    static const size_t maxEntries;
+
+private:
+    static std::string listPath();
+    static bool save(const std::vector<Entry> &entries);
+};
