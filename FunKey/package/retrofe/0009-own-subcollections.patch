diff --git a/RetroFE/Source/Collection/CollectionInfo.h b/RetroFE/Source/Collection/CollectionInfo.h
index 0cedb9f..3fe50d7 100755
--- a/RetroFE/Source/Collection/CollectionInfo.h
+++ b/RetroFE/Source/Collection/CollectionInfo.h
@@ -32,6 +32,14 @@ public:
     void sortPlaylists();
     void addSubcollection(CollectionInfo *info);
     void addSubcollectionPlaylist(CollectionInfo *info, const std::string &playlist);
+    // A collection assembled from .sub files borrows every item from the
+    // subcollections that were built to find them. Those subcollections must
+    // outlive it -- Item::collectionInfo points back at them, for launching
+    // and for writing favorites to the system a game belongs to -- so the
+    // aggregate takes ownership of them and frees them with itself. Without
+    // this, every visit to such a menu leaks one CollectionInfo per system,
+    // with every game on the card constructed again inside it.
+    void ownSubcollection(CollectionInfo *subcollection);
     static void markFavorite(Item *item, bool favorite);
     static const std::string favoriteMarker;
     void extensionList(std::vector<std::string> &extensions);
@@ -51,6 +59,8 @@ public:
 private:
     std::string metadataPath_;
     std::string extensions_;
+    // Collections whose lifetime this object owns; see ownSubcollection().
+    std::vector<CollectionInfo *> ownedSubcollections_;
     static bool itemIsLess(Item *lhs, Item *rhs);
 
 };
