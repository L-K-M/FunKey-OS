diff --git a/RetroFE/Source/Collection/CollectionInfo.cpp b/RetroFE/Source/Collection/CollectionInfo.cpp
index 0a3cbae..388307a 100755
--- a/RetroFE/Source/Collection/CollectionInfo.cpp
+++ b/RetroFE/Source/Collection/CollectionInfo.cpp
@@ -71,6 +71,27 @@ CollectionInfo::~CollectionInfo()
         items.erase(it);
         it = items.begin();
     }
+
+    // Only now that every Item has been deleted exactly once, through this
+    // collection's own items list: the owned subcollections hold pointers to
+    // those very same objects, so their lists must be emptied rather than
+    // walked. Deleting them earlier would have them delete Items twice, and
+    // leaving them undeleted leaked one collection per system per visit.
+    for(std::vector<CollectionInfo *>::iterator sub = ownedSubcollections_.begin();
+        sub != ownedSubcollections_.end(); ++sub)
+    {
+        (*sub)->items.clear();
+        delete *sub;
+    }
+    ownedSubcollections_.clear();
+}
+
+void CollectionInfo::ownSubcollection(CollectionInfo *subcollection)
+{
+    if(subcollection && subcollection != this)
+    {
+        ownedSubcollections_.push_back(subcollection);
+    }
 }
 
